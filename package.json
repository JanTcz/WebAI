{
  "name": "webai",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "description": "Click an element on your site, tell an AI agent what to change: it edits the source. Any dev server, plus a web editor that needs no install.",
  "scripts": {
    "dev": "npm --prefix examples/astro run dev",
    "editor": "node editor/serve.mjs",
    "bridge": "node packages/webai/bin/webai.js bridge --root examples/astro",
    "docker": "docker compose up",
    "test": "npm run coverage && node --test editor/*.test.js editor/proxy/*.test.js && npm --prefix examples/astro test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='packages/webai/src/**' --test-coverage-include='packages/webai/bin/**' --test-coverage-exclude='packages/webai/src/client/**' --test-coverage-exclude='packages/webai/bin/webai.js' --test-coverage-exclude='packages/webai/bin/webai-bridge.js' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 packages/webai/test/*.test.js",
    "editor:proxy": "node editor/proxy/serve-local.mjs"
  }
}
