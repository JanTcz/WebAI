---
/** Browser window with a selected heading and the chat panel, pure SVG. */
---

<figure class="hero-art" aria-hidden="true">
  <svg viewBox="0 0 520 380" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect x="1" y="1" width="518" height="378" rx="14" fill="#181a30" stroke="#2E2F4A" />
    <circle cx="22" cy="20" r="5" fill="#2E2F4A" /><circle cx="38" cy="20" r="5" fill="#2E2F4A" /><circle cx="54" cy="20" r="5" fill="#2E2F4A" />
    <rect x="80" y="12" width="200" height="16" rx="8" fill="#0F1020" />
    <line x1="1" y1="40" x2="519" y2="40" stroke="#2E2F4A" />

    <rect x="28" y="70" width="220" height="44" rx="4" stroke="#7C5CFF" stroke-width="2" stroke-dasharray="6 4" fill="rgb(124 92 255 / 12%)" />
    <rect x="38" y="82" width="170" height="10" rx="5" fill="#D4D4E6" />
    <rect x="38" y="98" width="120" height="8" rx="4" fill="#D4D4E6" opacity=".6" />
    <rect x="28" y="130" width="200" height="7" rx="3.5" fill="#9A9AB8" opacity=".5" />
    <rect x="28" y="145" width="180" height="7" rx="3.5" fill="#9A9AB8" opacity=".5" />
    <rect x="28" y="172" width="96" height="28" rx="14" fill="#6A4CF0" />
    <rect x="28" y="224" width="100" height="70" rx="8" fill="#0F1020" />
    <rect x="138" y="224" width="100" height="70" rx="8" fill="#0F1020" />

    <rect x="276" y="56" width="226" height="306" rx="12" fill="#0F1020" stroke="#2E2F4A" />
    <text x="292" y="80" fill="#FFFFFF" font-family="system-ui, sans-serif" font-size="13" font-weight="600">✦ WebAI</text>
    <text x="292" y="102" fill="#A48BFF" font-family="ui-monospace, monospace" font-size="10">Hero.astro:9:7 · h1</text>
    <rect x="330" y="118" width="158" height="42" rx="10" fill="#6A4CF0" />
    <text x="342" y="136" fill="#FFFFFF" font-family="system-ui, sans-serif" font-size="11">Shorter heading,</text>
    <text x="342" y="151" fill="#FFFFFF" font-family="system-ui, sans-serif" font-size="11">more contrast</text>
    <rect x="290" y="172" width="180" height="58" rx="10" fill="#181a30" />
    <text x="302" y="191" fill="#D4D4E6" font-family="system-ui, sans-serif" font-size="11">Edited in Hero.astro:9,</text>
    <text x="302" y="206" fill="#D4D4E6" font-family="system-ui, sans-serif" font-size="11">color via --text.</text>
    <text x="302" y="221" fill="#9A9AB8" font-family="system-ui, sans-serif" font-size="10">done · 5 s</text>
    <rect x="290" y="316" width="198" height="32" rx="8" fill="#181a30" stroke="#2E2F4A" />
    <text x="302" y="336" fill="#9A9AB8" font-family="system-ui, sans-serif" font-size="11">What to change?</text>
  </svg>
</figure>

<style>
  .hero-art { filter: drop-shadow(0 30px 60px var(--glow)); }
  .hero-art svg { width: 100%; }
</style>
