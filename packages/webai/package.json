{
  "name": "@jantcz/webai",
  "version": "0.2.0",
  "description": "Click an element on your site, tell an AI coding agent what to change: it edits the source. For any dev server: CLI, Vite, Astro, Next.js. Claude Code, Codex, Gemini CLI, OpenCode, Pi or a built-in agent with free models.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanTcz/WebAI.git",
    "directory": "packages/webai"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": "./src/client/overlay.js",
    "./astro": {
      "types": "./src/astro/index.d.ts",
      "default": "./src/astro/index.js"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    },
    "./next": {
      "types": "./src/next/index.d.ts",
      "default": "./src/next/index.js"
    },
    "./next/script": {
      "types": "./src/next/script.d.ts",
      "default": "./src/next/script.js"
    },
    "./html": "./src/html.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "webai": "./bin/webai.js",
    "webai-bridge": "./bin/webai-bridge.js"
  },
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "agents",
    "bin"
  ],
  "keywords": [
    "ai",
    "devtools",
    "visual-editing",
    "claude",
    "codex",
    "gemini",
    "opencode",
    "vite-plugin",
    "astro-integration",
    "withastro",
    "nextjs",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "astro": ">=7",
    "vite": ">=5",
    "next": ">=14",
    "react": ">=18"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
